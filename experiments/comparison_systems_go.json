{
  "version": "comparison-systems-v2",
  "systems": [
    {
      "id": "native-control",
      "mcp_enabled": false,
      "upstreams": [],
      "environment": {},
      "prompt_policy": "",
      "prepare_commands": [],
      "check_commands": [],
      "version_command": [
        "opencode",
        "--version"
      ]
    },
    {
      "id": "retrieval-mcp",
      "mcp_enabled": true,
      "server": "target/release/retrieval-mcp",
      "upstreams": [
        {
          "id": "retrieval",
          "command": [
            "{server}",
            "--root",
            "{root}",
            "--semantic-command",
            "{semantic_command_json}",
            "--timeout-seconds",
            "120"
          ],
          "environment": {},
          "visible_tools": [
            "search_exact",
            "read_source",
            "find_callers",
            "search_concept"
          ],
          "expected_upstream_tools": [
            "search_exact",
            "read_source",
            "find_callers",
            "search_concept"
          ]
        }
      ],
      "environment": {},
      "prompt_policy": "Stopping rule. Every row this server returns is a verified source fact: it names a real definition with its file, and `counts`, `has_more` and the relation labels state how complete the listing is. When the rows you already hold contain every fact the question asks for, answer from them. Do not read a definition's source to confirm a row that already named it, do not repeat a lookup you have already made, and do not reconfirm one tool's rows with another tool. Retrieve again only when a required fact is missing, ambiguous, contradicted, or truncated - `has_more` true, or a count larger than the rows shown. If multiple visible symbols plausibly satisfy a requested fact, disambiguate between those candidates before answering. Do not expand merely to reconfirm a single unambiguous candidate. When you do read source, read the narrowest range that carries the missing fact.",
      "prepare_commands": [
        [
          "python3",
          "{experiments}/warm_semantic.py",
          "--root",
          "{root}",
          "--cache",
          "{state}/semantic-cache",
          "--server",
          "{server}",
          "--semantic-command",
          "{semantic_command_json}",
          "--timeout",
          "600"
        ]
      ],
      "check_commands": [],
      "version_command": [
        "{server}",
        "--version"
      ]
    },
    {
      "id": "zvec-grep",
      "mcp_enabled": true,
      "upstreams": [
        {
          "id": "zvec",
          "command": [
            "{shared}/zvec/node_modules/.bin/zg",
            "server",
            "--stdio",
            "--listen",
            "{listen}",
            "--mcp-toolset",
            "full"
          ],
          "environment": {},
          "visible_tools": [
            "zvec_grep_search",
            "zvec_grep_rg"
          ],
          "expected_upstream_tools": [
            "zvec_grep_search",
            "zvec_grep_rg",
            "zvec_grep_index",
            "zvec_grep_index_drop",
            "zvec_grep_index_status",
            "zvec_grep_server_status"
          ]
        }
      ],
      "environment": {
        "ZVEC_GREP_HOME": "{state}/home",
        "ZVEC_GREP_MODE": "server",
        "ZVEC_GREP_MCP_TOOLSET": "full",
        "ZVEC_GREP_MODEL_CACHE": "{shared}/zvec-model-cache"
      },
      "prompt_policy": "",
      "prepare_commands": [
        [
          "npm",
          "install",
          "--prefix",
          "{shared}/zvec",
          "--no-audit",
          "--no-fund",
          "/tmp/zvec-package/zvec-zvec-grep-0.2.2.tgz"
        ],
        [
          "{shared}/zvec/node_modules/.bin/zg",
          "index",
          "{root}",
          "--embedding",
          "local/potion-code-16m-v2",
          "--mode",
          "direct"
        ]
      ],
      "check_commands": [
        [
          "{shared}/zvec/node_modules/.bin/zg",
          "status",
          "{root}",
          "--mode",
          "direct",
          "--check-ready"
        ]
      ],
      "version_command": [
        "{shared}/zvec/node_modules/.bin/zg",
        "version"
      ]
    }
  ]
}
