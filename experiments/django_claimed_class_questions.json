    "id": "djt-inspect-signature",
    "category": "container_and_callers",
    "set": "dev",
    "question": "The signing module's core class exposes a method returning the base64 keyed hash it computes for a given string, using its configured algorithm, key and salt. Identify the class that defines that method, and every definition outside the signing module that calls a method of the same name. Answer as a JSON object with keys \"container\" and \"callers\", where container is one path::name and callers is a list of path::name.",
    "helper": "django/core/signing.py::signature",
    "caller_key": "callers",
    "exhaustive": true,
    "expected_json": {
      "answer": {
        "container": "django/core/signing.py::Signer",
        "callers": [
          "django/core/checks/security/csrf.py::check_csrf_failure_view",
          "django/core/checks/urls.py::check_custom_error_handlers",
          "django/db/models/expressions.py::_constructor_signature",
          "django/utils/inspect.py::_get_func_parameters"
        ]
      }
    },
    "rejected_alternates": [
      "django/core/signing.py::signature",
      "django/core/signing.py::Signerx"
    ],
    "evidence": [
      {
        "path": "django/core/signing.py",
        "contains": "    def signature(self, value, key=None):"
      },
      {
        "path": "django/core/signing.py",
        "contains": "class Signer:"
      },
      {
        "path": "django/core/checks/security/csrf.py",
        "contains": "            inspect.signature(view).bind(None, reason=None)"
      },
      {
        "path": "django/core/checks/urls.py",
        "contains": "        signature = inspect.signature(handler)"
      }
    ],
    "author_notes": "Gold pairs one container with an exhaustive caller set verified by ripgrep: Signer in django/core/signing.py, 4 callers across 4 files. The class is claimed for inspect_symbol because both facts - the container of a definition and its inbound edges - come back in a single capped call with complete counts, where a baseline surface must enumerate callers and then read the definition's own file to name its container.",
    "tool_path": [
      {
        "tool": "search_concept",
        "arguments": {
          "query": "base64 hmac salt key algorithm compute signature for value",
          "limit": 10
        },
        "expect": [
          "django/core/signing.py::signature"
        ]
      },
